@echo off
rem Distribution settings for BEAM clustering. Rust overrides RELEASE_NODE and
rem RELEASE_COOKIE per world; these defaults just let the artifact boot alone.
if "%RELEASE_DISTRIBUTION%"=="" set RELEASE_DISTRIBUTION=name
if "%RELEASE_NODE%"=="" set RELEASE_NODE=rs_ether@127.0.0.1
if "%RELEASE_COOKIE%"=="" set RELEASE_COOKIE=rs_secret
