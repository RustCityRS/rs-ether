#!/bin/sh
# Distribution settings for BEAM clustering (libcluster Epmd strategy).
# The Rust world overrides RELEASE_NODE per world (e.g. world10@127.0.0.1) and
# RELEASE_COOKIE; these defaults just let the artifact boot and cluster on its
# own. RS_* env vars (DB, port, cluster hosts) are consumed by config/runtime.exs.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_NODE="${RELEASE_NODE:-rs_ether@127.0.0.1}"
export RELEASE_COOKIE="${RELEASE_COOKIE:-rs_secret}"
